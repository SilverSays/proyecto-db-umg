# ---------------------------------------------------------------------------
# Sistema Académico UMG — configuración de entorno
# Copie este archivo como ".env" y ajuste los valores. NUNCA suba .env a GitHub.
# ---------------------------------------------------------------------------

APP_NAME="Sistema Académico UMG"
# production | development | demo
APP_ENV=development
# Muestra detalles técnicos de los errores (desactivar en producción)
APP_DEBUG=true
# Muestra las credenciales de demostración en el login (solo para la demo)
APP_SHOW_DEMO_CREDENTIALS=true

# ---- Oracle Database (Easy Connect //HOST:PUERTO/SERVICIO) ----
DB_HOST=localhost
DB_PORT=1521
# XEPDB1 para Oracle XE 21c · FREEPDB1 para Oracle Database 23ai Free
DB_SERVICE=XEPDB1
DB_USERNAME=umg_academico
DB_PASSWORD="Umg_Acad_2026#"

# ---- Seguridad ----
# Minutos de inactividad antes de cerrar la sesión (en segundos)
SESSION_IDLE_TIMEOUT=1800
# Intentos fallidos permitidos antes de bloquear la cuenta
LOGIN_MAX_ATTEMPTS=5
# Duración del bloqueo (minutos)
LOGIN_LOCK_MINUTES=15
